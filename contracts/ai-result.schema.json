{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://svara-ai.local/contracts/ai-result.schema.json",
  "title": "SVARA AI Analysis Unit Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unit_id",
    "source_row_number",
    "text",
    "sentiment",
    "confidence",
    "probabilities",
    "topic_id",
    "keywords"
  ],
  "properties": {
    "unit_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_row_number": {
      "type": "integer",
      "minimum": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "sentiment": {
      "type": "string",
      "enum": ["positive", "neutral", "negative"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "probabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive", "neutral", "negative"],
      "properties": {
        "positive": {"type": "number", "minimum": 0, "maximum": 1},
        "neutral": {"type": "number", "minimum": 0, "maximum": 1},
        "negative": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "topic_id": {
      "type": "integer",
      "minimum": -1
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyword", "weight", "rank"],
        "properties": {
          "keyword": {"type": "string", "minLength": 1},
          "weight": {"type": "number", "minimum": 0},
          "rank": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
